  "recordPeriodOverrides": {
    "fz-v62-jin-wanghun-yuzhou": {
      "seatPeriodId": "seat-period:jin:yuzhou:266-279:ancheng",
      "reason": "《晋书》将领豫州刺史置于迁安东将军镇寿春、伐吴以前；据豫州平吴前分期对应汝南郡安成。"
    },
    "fz-v62-jin-yingchuo-yangzhou": {
      "seatPeriodId": "seat-period:jin:yangzhou:266-279:shouchun",
      "reason": "应绰受王浑节度攻吴屯，发生于晋平吴以前；据扬州迁治分期对应寿春。"
    },
    "fz-v62-jin-qianhong-liangzhou": {
      "seatPeriodId": null,
      "reason": "泰始七年原文只确认牵弘任凉州刺史并战死，尚无逐条材料证明其州治或实际驻地，整条暂缓公开。"
    },
    "fz-v62-jin-zhanggui-liangzhou": {
      "seatPeriodId": "seat-period:jin:zhanggui:304-314:guzang",
      "reason": "《晋书》张轨传直书永兴中大城姑臧，仅登记其任内可确认的姑臧实际驻地，不外推为266—316年通用州治。"
    },
    "fz-v62-jin-zhangshi-liangzhou": {
      "seatPeriodId": "seat-period:jin:zhangshi:314-316:guzang",
      "reason": "《晋书》张轨传记张寔及至姑臧，继而摄父位并受凉州刺史，登记为人物实际驻地。"
    },
    "fz-v62-jin-luoshang-liangzhou": {
      "seatPeriodId": "seat-period:jin:liangzhou-hanzhong:267-290:nanzheng",
      "reason": "罗尚太康末任梁州刺史，处于梁州治汉中南郑的早期分期内；不把该分期延伸至李特乱后。"
    },
    "fz-v62-jin-zhangguang-liangzhou": {
      "seatPeriodId": null,
      "reason": "原文只确认张光至汉中，不能据此把人物实际驻地等同于梁州州治南郑，整条暂缓公开。"
    },
    "fz-v62-jin-luoshang-yizhou": {
      "seatPeriodId": "seat-period:jin:yizhou:266-303:chengdu",
      "reason": "罗尚永宁元年受益州刺史，成都仅按李特据城前的301—303年阶段登记，不延伸至其后任期。"
    },
