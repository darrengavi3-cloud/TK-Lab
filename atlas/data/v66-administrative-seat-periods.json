    "publication": "公开治所必须有稳定行政单元、有效年代、可访问来源、定位和原文摘录；无法确定者整条州镇记录暂缓公开。",
    "temporalMatching": "同一州发生迁治时按年代分段；任期不明且跨越迁治边界者不得猜测。",
    "sourceBoundary": "《宋书》《魏书》等后出地理志仅用于回溯魏晋州治，并与《晋书》人物或帝纪记录交叉核对。"
  },
  "sources": [
    {
      "sourceId": "songshu-035-xuzhou",
      "sourceTitle": "《宋书》卷三十五·州郡志一",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/宋書/卷35",
      "sourceLocator": "徐州条",
      "sourceExcerpt": "徐州刺史，後漢治東海郯縣，魏、晉、宋治彭城。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    },
    {
      "sourceId": "songshu-035-yangzhou",
      "sourceTitle": "《宋书》卷三十五·州郡志一",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/宋書/卷35",
      "sourceLocator": "扬州条",
      "sourceExcerpt": "揚州刺史，前漢刺史未有所治，後漢治歷陽，魏、晉治壽春，晉平吳治建業。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    },
    {
      "sourceId": "songshu-035-jiankang-name",
      "sourceTitle": "《宋书》卷三十五·州郡志一",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/宋書/卷35",
      "sourceLocator": "丹阳尹·建康令条",
      "sourceExcerpt": "太康三年，分秣陵之水北为建业。愍帝即位，避帝讳，改为建康。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    },
    {
      "sourceId": "songshu-035-yanzhou",
      "sourceTitle": "《宋书》卷三十五·州郡志一",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/宋書/卷35",
      "sourceLocator": "兖州条",
      "sourceExcerpt": "兗州刺史，後漢治山陽昌邑，魏、晉治廩丘。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    },
    {
      "sourceId": "songshu-036-yuzhou",
      "sourceTitle": "《宋书》卷三十六·州郡志二",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/宋書/卷36",
      "sourceLocator": "豫州条",
      "sourceExcerpt": "豫州刺史，後漢治譙，魏治汝南安成，晉平吳後治陳國。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    },
    {
      "sourceId": "songshu-036-qingzhou",
      "sourceTitle": "《宋书》卷三十六·州郡志二",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/宋書/卷36",
      "sourceLocator": "青州条",
      "sourceExcerpt": "青州刺史，治臨淄。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    },
    {
      "sourceId": "songshu-037-jingzhou",
      "sourceTitle": "《宋书》卷三十七·州郡志三",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/宋書/卷37",
      "sourceLocator": "荆州条",
      "sourceExcerpt": "荊州刺史，漢治武陵漢壽，魏、晉治江陵，王敦治武昌，陶侃前治沔陽，後治武昌。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    },
    {
      "sourceId": "songshu-037-liang-yizhou",
      "sourceTitle": "《宋书》卷三十七·州郡志三",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/宋書/卷37",
      "sourceLocator": "梁州条",
      "sourceExcerpt": "魏元帝景元四年平蜀，復立梁州，治漢中南鄭，而益州治成都。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    },
    {
      "sourceId": "songshu-038-jiaoguang",
      "sourceTitle": "《宋书》卷三十八·州郡志四",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/宋書/卷38",
      "sourceLocator": "交州条",
      "sourceExcerpt": "及分為廣州，治番禺，交州還治龍編。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    },
    {
      "sourceId": "jinshu-014-yongzhou",
      "sourceTitle": "《晋书》卷十四·地理志上",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/晉書/卷014",
      "sourceLocator": "雍州条",
      "sourceExcerpt": "晉初於長安置雍州，統郡國七，縣三十九……建興之後，雍州沒於劉聰。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    },
    {
      "sourceId": "jinshu-014-liangzhou",
      "sourceTitle": "《晋书》卷十四·地理志上",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/晉書/卷014",
      "sourceLocator": "凉州条；武威郡及永宁中张轨段",
      "sourceExcerpt": "永寧中，張軌為涼州刺史，鎮武威，上表請合秦雍流移人於姑臧西北，置武興郡。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    },
    {
      "sourceId": "jinshu-014-liang-hanzhong",
      "sourceTitle": "《晋书》卷十四·地理志上",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/晉書/卷014",
      "sourceLocator": "梁州条",
      "sourceExcerpt": "泰始三年，分益州，立梁州於漢中……尋而梁州郡縣沒於李特，永嘉中又分屬楊茂搜。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    },
    {
      "sourceId": "jinshu-014-yizhou",
      "sourceTitle": "《晋书》卷十四·地理志上",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/晉書/卷014",
      "sourceLocator": "益州条；蜀郡县目",
      "sourceExcerpt": "蜀郡：成都、廣都、繁、江原、臨邛、郫……惠帝之後，李特僭號於蜀，益州郡縣皆沒於特。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    },
    {
      "sourceId": "jinshu-086-zhang-guzang",
      "sourceTitle": "《晋书》卷八十六·张轨传",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/晉書/卷086",
      "sourceLocator": "张轨永兴中大城姑臧段；张寔及至姑臧、摄父位段",
      "sourceExcerpt": "永興中……於是大城姑臧……寔……及至姑臧……軌卒，州人推寔攝父位。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    },
    {
      "sourceId": "weishu-106a-jizhou",
      "sourceTitle": "《魏书》卷一百六上·地形志二上",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/魏書/卷106上",
      "sourceLocator": "冀州条",
      "sourceExcerpt": "冀州，後漢治高邑，袁紹、曹操為冀州，治鄴，魏、晉治信都，晉世邵續治厭次。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    },
    {
      "sourceId": "houhanshu-075-lvbu",
      "sourceTitle": "《后汉书》卷七十五·吕布传",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/後漢書/卷75",
      "sourceLocator": "兴平元年张邈迎吕布段",
      "sourceExcerpt": "遂與弟超及宮等迎布為兗州牧，據濮陽，郡縣皆應之。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    },
    {
      "sourceId": "sanguozhi-043-lihui",
      "sourceTitle": "《三国志》卷四十三·李恢传",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/三國志/卷43",
      "sourceLocator": "章武元年邓方卒后选代段",
      "sourceExcerpt": "遂以恢為庲降都督，使持節領交州刺史，住平夷縣。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    },
    {
      "sourceId": "jinshu-042-wanghun",
      "sourceTitle": "《晋书》卷四十二·王浑传",
      "sourceUrl": "https://zh.wikisource.org/zh-hans/晉書/卷042",
      "sourceLocator": "王浑领豫州刺史至迁安东将军镇寿春段",
      "sourceExcerpt": "轉征虜將軍、監豫州諸軍事、假節，領豫州刺史……遷安東將軍、都督揚州諸軍事，鎮壽春。",
      "sourceLevel": "一手史料",
      "accessedAt": "2026-08-30"
    }
  ],
