    },
    {
      "reviewId": "identity-review:v75:5",
      "personId": "person:source:6225fb017a4d",
      "name": "于治戎",
      "status": "verified",
      "action": "suppress",
      "reason": "于治戎为长是对诸葛亮才能的评价；于治戎不是姓名。",
      "citations": [
        {
          "title": "《三国志》卷35·陈寿上诸葛亮集表",
          "url": "https://zh.wikisource.org/wiki/三國志/卷35",
          "quote": "然亮才，於治戎為長，奇謀為短，理民之幹，優於將略。而所與對敵，或值人傑，加眾寡不侔，攻守異體，故雖連年動眾，未能有克。"
        }
      ],
