    {
      "reviewId": "identity-review:v80:2",
      "personId": "person:source:5a26d1185d64",
      "name": "虞大",
      "status": "verified",
      "action": "suppress",
      "reason": "虞大来自“虞大司马”断词，指刘虞与大司马官衔，不是独立人名；全部关联仅此误抽。",
      "citations": [
        {
          "title": "《三國志》卷08 公孫瓚傳附劉虞·董卓至洛阳；下句关东义兵起与迁都长安",
          "url": "https://zh.wikisource.org/wiki/三國志/卷08",
          "quote": "會董卓至洛陽，遷虞大司馬，瓚奮武將軍，封薊侯。",
          "note": "原典定位节引；完整上下文见链接，非全卷校录。 前文明确‘乃以劉虞為幽州牧’，因此虞为刘虞简称，大属于大司马官名。"
        },
        {
          "title": "《三國志》卷08 公孫瓚傳附劉虞·关东义兵起、董卓劫帝西迁（190）",
          "url": "https://zh.wikisource.org/wiki/三國志/卷08",
          "quote": "關東義兵起，卓遂劫帝西遷，徵虞為太傅，道路隔塞，信命不得至。",
          "note": "原典定位节引；完整上下文见链接，非全卷校录。"
        },
        {
          "title": "《後漢書》卷9 孝獻帝紀·中平六年（189）九月，改昭宁为永汉之后",
          "url": "https://zh.wikisource.org/wiki/後漢書/卷9",
          "quote": "乙酉，以太尉劉虞爲大司馬。董卓自爲太尉，加鈇鉞、虎賁。",
          "note": "原典定位节引；完整上下文见链接，非全卷校录。"
        },
        {
          "title": "《後漢書》卷9 孝獻帝紀·初平四年（193）冬十月段，十二月段之前",
          "url": "https://zh.wikisource.org/wiki/後漢書/卷9",
          "quote": "司空楊彪免，太常趙溫爲司空。公孫瓉殺大司馬劉虞。",
          "note": "原典定位节引；完整上下文见链接，非全卷校录。"
        },
        {
          "title": "《後漢書》卷73 劉虞列傳·董卓秉政至初平元年",
          "url": "https://zh.wikisource.org/wiki/後漢書/卷73",
          "quote": "及董卓秉政，遣使者授虞大司馬，進封襄賁侯。初平元年，復征代袁隗為太傅。",
          "note": "原典定位节引；完整上下文见链接，非全卷校录。 确认大司马为授任；后句征太傅须结合三国志信命不得至判定"
        }
      ],
