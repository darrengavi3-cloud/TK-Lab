    {
      "reviewId": "identity-review:v80:3",
      "personId": "person:source:f741747b83c4",
      "name": "武卫",
      "status": "verified",
      "action": "suppress",
      "reason": "武卫是官号前缀。全部四条分别指曹爽武卫将军、许褚武卫中郎将及武卫将军、孙峻武卫将军，没有名为武卫的人物依据。",
      "citations": [
        {
          "title": "《三國志》卷九《曹真傳》附曹爽·曹爽传开篇",
          "url": "https://zh.wikisource.org/wiki/三國志/卷09",
          "quote": "爽字昭伯，少以宗室謹重，明帝在東宮，甚親愛之。及即位，爲散騎侍郎，累遷城門校尉，加散騎常侍，轉武衞將軍，寵待有殊。帝寢疾，乃引爽入臥內，拜大將軍，假節鉞，都督中外諸軍事，錄尚書事，與太尉司馬宣王並受遺詔輔少主。",
          "note": "原典定位节引；完整上下文见链接，非全卷校录。"
        },
        {
          "title": "《三國志》卷三《明帝紀》·景初二年十二月",
          "url": "https://zh.wikisource.org/wiki/三國志/卷03",
          "quote": "十二月乙丑，帝寢疾不豫。辛巳，立皇后。賜天下男子爵人二級，鰥寡孤獨穀。以燕王宇爲大將軍，甲申免，以武衞將軍曹爽代之。",
          "note": "原典定位节引；完整上下文见链接，非全卷校录。"
        },
        {
          "title": "《三國志》卷18·许褚传·文帝践阼",
          "url": "https://zh.wikisource.org/wiki/三國志/卷18",
          "quote": "文帝踐阼，進封萬歲亭侯，遷武衛將軍，都督中軍宿衛禁兵，甚親近焉。",
          "note": "原典定位节引；完整上下文见链接，非全卷校录。"
        },
        {
          "title": "《三國志》卷18·许褚传·明帝即位后",
          "url": "https://zh.wikisource.org/wiki/三國志/卷18",
          "quote": "明帝即位，進牟鄉侯，邑七百戶，賜子爵一人關內侯。褚薨，謚曰壯侯。",
          "note": "原典定位节引；完整上下文见链接，非全卷校录。"
        },
        {
          "title": "《三國志》卷18·许褚传·潼关战后",
          "url": "https://zh.wikisource.org/wiki/三國志/卷18",
          "quote": "後數日會戰，大破超等，褚身斬首級，遷武衛中郎將。武衛之號，自此始也。",
          "note": "原典定位节引；完整上下文见链接，非全卷校录。"
        },
        {
          "title": "《三國志》卷18·许褚传·曹仁来朝后",
          "url": "https://zh.wikisource.org/wiki/三國志/卷18",
          "quote": "太祖聞，愈愛待之，遷中堅將軍。",
          "note": "原典定位节引；完整上下文见链接，非全卷校录。"
        },
        {
          "title": "《三國志》卷64·孙峻传·孙权临薨",
          "url": "https://zh.wikisource.org/wiki/三國志/卷64",
          "quote": "孫峻字子遠，孫堅弟靜之曾孫也。",
          "note": "原典定位节引；完整上下文见链接，非全卷校录。"
        },
        {
          "title": "《三國志》卷64·孙峻传·受遗辅政",
          "url": "https://zh.wikisource.org/wiki/三國志/卷64",
          "quote": "權臨薨，受遺輔政，領武衛將軍，故典宿衛，封都鄉侯。",
          "note": "原典定位节引；完整上下文见链接，非全卷校录。"
        }
      ],
