{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build:atlas": "node atlas/scripts/build-all.mjs",
    "build": "npm run build:atlas && npm run sync:reader && npm run build:site",
    "build:site": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/prune-site-build.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "sync:reader": "node scripts/sync-reader-bundle.mjs",
    "test": "npm run build && npm run test:built",
    "test:built": "node --test tests/*.test.mjs",
    "test:source": "node --test tests/reader-semantics.test.mjs tests/office-succession.test.mjs tests/research-worklist.test.mjs tests/access-policy.test.mjs tests/reader-refinement.test.mjs tests/shiyuan-citation.test.mjs tests/reader-product.test.mjs",
    "test:visual": "node --test tests/visual/*.test.mjs",
    "release:offline": "node atlas/scripts/release-check.mjs && npm run sync:reader && npm run typecheck && npm run lint && npm run build:site && npm run test:built",
    "release:access": "REQUIRE_FRESH_SITE_ACCESS=1 node --test tests/access-policy.test.mjs",
    "release:check": "npm run release:offline && npm run release:access",
    "typecheck": "tsc --noEmit --incremental false",
    "types:generate": "node scripts/generate-worker-types.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:runtime": "node scripts/check-worker-runtime.mjs",
    "test:catalogue": "node --test tests/catalogue-core.test.mjs tests/catalogue-migration.test.mjs",
    "migrate:shadow": "node importers/legacy-atlas/index.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "playwright": "1.56.1",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.0.16",
    "wrangler": "4.130.0"
  },
  "type": "module",
  "overrides": {
    "sharp": "$sharp",
    "wrangler": {
      "esbuild": "0.28.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
