  "excludedStrikethrough": [
    {
      "paragraph": 729,
      "text": "【铭文】晋故大司农关中侯郑舒夫┘人城阳黔陬刘氏，魏琅耶太┘守谟之孙，晋使持节领护匈┘奴中郎将鹰扬将军并州刺┘史菅丘烈男钦之女。夫人年。┘北京图书馆藏拓"
    },
    {
      "paragraph": 1297,
      "text": "鲁诠墓志（咸宁四年）"
    },
    {
      "paragraph": 1318,
      "text": "右晋《张永昌墓版》，未详出土时地。形制长方，圭其首，高二十六厘米，广十五厘米，略如一小汉碑。碑面圭首刻双龙，碑身左右各有一侍者像。中间文字三行，曰：“晋故谯郡功曹史镇南将军颍阴张君永昌之袖柩。”碑阴圭首刻二兽，状似鹿而有翼，碑身左右侍女各一，中间字二行，曰：“夫人天水赵氏，泰始四年七月三日造。”出《北山集古录》"
    },
    {
      "paragraph": 1319,
      "text": "案：当为伪刻。"
    },
    {
      "paragraph": 1327,
      "text": "郗氏墓 此伪碑也"
    },
    {
      "paragraph": 1328,
      "text": "晋前右将军会稽内史王府君夫人高平金乡都乡【高】平里郗氏之墓识"
    },
    {
      "paragraph": 1329,
      "text": "晉前右將軍會稽内史王府君夫人高平金鄉都鄉"
    },
    {
      "paragraph": 1330,
      "text": "平里郗氏之墓識"
    },
    {
      "paragraph": 1331,
      "text": "前右將軍會稽内史琅耶臨沂都鄉南仁里諱羲之【字】"
    },
    {
      "paragraph": 1332,
      "text": "逸少年五十六"
    },
    {
      "paragraph": 1333,
      "text": "長子"
    },
    {
      "paragraph": 1334,
      "text": "次子玄之字仲思妻【笔者按：此处应为“南”，范汪资料可查。】陽范氏父諱汪字玄平吏部【尚】書"
    },
    {
      "paragraph": 1335,
      "text": "次子凝之字叔平妻陳國謝氏父諱奕字無奕使【持節】"
    },
    {
      "paragraph": 1336,
      "text": "安西將軍豫州刺史"
    },
    {
      "paragraph": 1337,
      "text": "次子渙之字季文妻穎川陳氏父諱逵字林道使【持節】"
    },
    {
      "paragraph": 1338,
      "text": "衛將軍淮南内史"
    },
    {
      "paragraph": 1339,
      "text": "次子肅之字幼恭妻陳國殷氏父諱浩字淵源使【持節】"
    },
    {
      "paragraph": 1340,
      "text": "中軍將軍揚州刺史"
    },
    {
      "paragraph": 1341,
      "text": "次子徽之字子猷妻汝南梅氏父諱籍字項羽熒陽【太】守"
    },
    {
      "paragraph": 1342,
      "text": "次子操之字子重妻濟陽江氏父諱霖（笔者按：李伟国先生断霖应为虨字无三撇。）字思玄右【将军】"
    },
    {
      "paragraph": 1343,
      "text": "會稽内史"
    },
    {
      "paragraph": 1344,
      "text": "次子獻之字子敬"
    },
    {
      "paragraph": 1345,
      "text": "女適南陽劉暢字序元撫軍大將軍掾父遐字子【笔者按，此当为“嵩”字，据笪桥刘氏网资料，东晋有两个刘遐，一个是陶侃属将刘遐字正长，晋书有传。一个是笪桥刘氏始祖刘遐字子嵩。刘畅父亲应是笪桥刘氏始祖刘遐字子嵩。】【右】"
    },
    {
      "paragraph": 1346,
      "text": "將軍會稽内史"
    },
    {
      "paragraph": 1347,
      "text": "夫人外氏沛國武氏"
    },
    {
      "paragraph": 1348,
      "text": "夫人長姊喪亂相失"
    },
    {
      "paragraph": 1349,
      "text": "妹適濟陰卞軫字道重封建興公"
    },
    {
      "paragraph": 1350,
      "text": "弟愔字方回臨海太守南昌公"
    },
    {
      "paragraph": 1351,
      "text": "妹適濟陽蔡奚字子叔太宰司馬"
    },
    {
      "paragraph": 1352,
      "text": "弟曇字重熙散騎常侍北中郎軍司"
    },
    {
      "paragraph": 1353,
      "text": "升平二年戌午歲四月甲寅朔七日庚申薨以其年五月廿八日庚戌葬會稽山陰南鄉離上里離東山尾"
    }
  ],
