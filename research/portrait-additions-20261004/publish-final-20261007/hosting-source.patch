index 0000000..511eb7b
--- /dev/null
+++ b/tests/hosting-export-mode.test.mjs
@@ -0,0 +1,29 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { execFileSync } from 'node:child_process';
+
+test('hosting manifest builds from a clean reader without offline exports', () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hosting-export-mode-'));
+  try {
+    const scripts = path.join(root, 'scripts');
+    const reader = path.join(root, 'exports', '观史台-读者版');
+    fs.mkdirSync(scripts, { recursive: true });
+    fs.mkdirSync(reader, { recursive: true });
+    fs.copyFileSync(new URL('../atlas/scripts/build-deployment-manifest.mjs', import.meta.url), path.join(scripts, 'build-deployment-manifest.mjs'));
+    fs.writeFileSync(path.join(root, 'sources.lock.json'), '{}\n');
+    fs.writeFileSync(path.join(reader, 'index.html'), '<!doctype html><title>reader</title>');
+    fs.writeFileSync(path.join(reader, 'reader-bundle.json'), '{}\n');
+    const script = path.join(scripts, 'build-deployment-manifest.mjs');
+    assert.throws(() => execFileSync(process.execPath, [script], { stdio: 'pipe' }), /缺少发布产物/);
+    execFileSync(process.execPath, [script, '--skip-portable'], { stdio: 'pipe' });
+    const manifest = JSON.parse(fs.readFileSync(path.join(root, 'exports', 'deployment-manifest.json'), 'utf8'));
+    assert.equal(manifest.fileCount, 2);
+    assert.ok(manifest.files.every(file => file.path.startsWith('exports/观史台-读者版/')));
+    assert.ok(manifest.files.every(file => fs.statSync(path.join(root, file.path)).size === file.bytes));
+  } finally {
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
