         <p v-if="src" class="sgz-portrait-status" role="status">{{failed?'立绘未能加载。':loading?'加载立绘…':''}}</p>
         <nav v-if="choices.length>1" class="sgz-portrait-choices" aria-label="切换人物立绘"><button v-for="(asset,index) in choices" :key="asset.portraitId" type="button" class="sgz-portrait-control" :data-portrait-id="asset.portraitId" :aria-pressed="src===asset.src" @click="choose(asset.portraitId)">立绘{{index+1}}</button></nav>
