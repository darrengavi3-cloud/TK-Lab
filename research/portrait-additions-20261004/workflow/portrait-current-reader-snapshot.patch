diff --git a/scripts/prune-site-build.mjs b/scripts/prune-site-build.mjs
index 344c288..e278fad 100644
--- a/scripts/prune-site-build.mjs
+++ b/scripts/prune-site-build.mjs
@@ -7,6 +7,27 @@ const projectRoot = process.cwd();
 const legacyRoot = path.join(projectRoot, 'dist', 'client', 'legacy');
 const portraitsRoot = path.join(legacyRoot, 'assets', 'portraits');
 
+// Framework builds may leave pre-existing public assets in dist. Re-establish
+// the verified current reader snapshot before generating any derivatives.
+const readerSourceRoot = path.join(projectRoot, 'public', 'legacy');
+const readerSourceManifestPath = path.join(readerSourceRoot, 'reader-bundle.json');
+const readerSourceManifest = JSON.parse(fs.readFileSync(readerSourceManifestPath, 'utf8'));
+const readerStagingRoot = path.join(projectRoot, 'dist', 'client', `.reader-current-${process.pid}`);
+const verifyReaderCopy = (directory) => {
+  for (const entry of readerSourceManifest.files) {
+    if (!entry.path || path.isAbsolute(entry.path) || entry.path.split(/[\\/]/).includes('..')) throw new Error('Unsafe reader manifest path');
+    const bytes = fs.readFileSync(path.join(directory, entry.path));
+    if (bytes.length !== entry.bytes || createHash('sha256').update(bytes).digest('hex') !== entry.sha256) throw new Error(`Current reader copy mismatch: ${entry.path}`);
+  }
+  if (!fs.readFileSync(path.join(directory, 'reader-bundle.json')).equals(fs.readFileSync(readerSourceManifestPath))) throw new Error('Current reader manifest copy mismatch');
+};
+verifyReaderCopy(readerSourceRoot);
+fs.rmSync(readerStagingRoot, { recursive: true, force: true });
+fs.cpSync(readerSourceRoot, readerStagingRoot, { recursive: true });
+verifyReaderCopy(readerStagingRoot);
+fs.rmSync(legacyRoot, { recursive: true, force: true });
+fs.renameSync(readerStagingRoot, legacyRoot);
+
 if (!fs.existsSync(legacyRoot)) {
   throw new Error(`Sites build output missing: ${legacyRoot}`);
 }
